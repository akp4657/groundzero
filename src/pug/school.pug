extends layouts/base

include mixins/coach-bio

mixin seminarGuestCard(seminarImg, guest, seminarTag, seminarDetail)
    .gz-coach-card.gz-roster-card.text-start.h-100
        .gz-roster-media
            img(src=seminarImg, alt='', decoding='async')
        .p-3
            h2.h5= guest.name
            if seminarTag
                p.small.text-muted.mb-2= seminarTag
            if seminarDetail
                p.small.mb-0= seminarDetail

append variables
    - pageTitle = 'School | Ground Zero Wrestling'
    - pageDescription = 'Train at Rochester’s premier pro wrestling school with coaches from major promotions worldwide.'
    - activeNav = 'school'

block content
    header.gz-page-header
        .container.px-4.px-lg-5
            h1.display-5 School
            p.lead.mb-0 Fully equipped facility, structured classes, and coaches invested in your growth

    section.page-section
        .container.px-4.px-lg-5
            .text-center.mb-4.mb-md-5
                img.gz-respect-the-craft-logo(
                    src='assets/img/brand/respect-the-craft.png',
                    alt='Respect the Craft'
                )
            .row.justify-content-center.mb-5
                .col-lg-10
                    .gz-school-text-panel
                        h2.h3 Welcome to GROUND ZERO
                        p.text-muted.mb-3
                            | A fully equppied training facility dedicated to helping new and experienced students train to become professional wrestlers.
                            | At GROUND ZERO, you will learn from a team of coaches with experience in nearly every notable wrestling promotion in the country as 
                            | well as promotions in Europe and Japan, giving you the skills, knowledge, and ethics you need to build yourself into the best professional wrestler you can be.
                        p.text-muted.mb-0
                            | At GROUND ZERO, wrestling comes first. Respect the Craft. There is no room for ego in this gym. Here, you will learn the art of professional wrestling
                            | and the importance of tradition while embracing the ever-expanding culture of the sport.

            .row.justify-content-center.mb-5
                .col-lg-10
                    .gz-school-text-panel.p-0.overflow-hidden
                        img.w-100(src='assets/img/coaches/GZ_School.jpg', alt='Ground Zero School training promotion')

            .row.gy-5

                .col-12
                    article#coach-colin.mb-5(aria-labelledby='coach-colin-heading')
                        .row.align-items-stretch.gy-3
                            .col-md-4.col-lg-3
                                .gz-coach-card.gz-roster-card.text-dark
                                    .gz-roster-media
                                        img(src='assets/img/coaches/Colin_Delaney.jpg', alt='', aria-hidden='true')
                                    .p-3
                                        h3#coach-colin-heading.h5.mb-0 Colin Delaney
                            .col-md-8.col-lg-9.d-flex.align-items-stretch
                                +coachBioPanel
                                    +coachBioLead
                                        | Colin Delaney is a veteran professional wrestler, trainer, and WWE alumnus with more than 20 years of experience in the professional wrestling industry. Having competed on national television for WWE’s ECW brand and across some of the most respected independent promotions in North America, Delaney brings a wealth of in-ring knowledge and real-world experience to every training session.
                                    +coachBioSection('Career Highlights')
                                        | Throughout his career, Delaney has captured numerous championships, including the AIW Absolute Championship, AIW Tag Team Championships, the NWA Empire Heavyweight Championship, NWA Empire Tag Team Championship, NWA Empire Lord of the Dance Championship, IWC Tag Team Championship, NWA Upstate Tag Team Championship, 2CW Tag Team Championship, and multiple regional titles across the independent wrestling scene.
                                    +coachBioSection('As a Trainer')
                                        | Colin emphasizes strong fundamentals, ring psychology, character development, conditioning, and professionalism. His coaching philosophy is built on preparing wrestlers for long-term success, whether their goals are to compete on the independent circuit, perform on television, or develop into complete professional athletes.
                                    +coachBioClose
                                        | Drawing from two decades of experience sharing the ring with top talent and performing before audiences around the world, Colin provides hands-on instruction that helps students sharpen their skills, build confidence, and gain a deeper understanding of every aspect of professional wrestling.

                    article#coach-mattick.mb-5(aria-labelledby='coach-mattick-heading')
                        .row.align-items-stretch.gy-3
                            .col-md-4.col-lg-3
                                .gz-coach-card.gz-roster-card.text-dark
                                    .gz-roster-media
                                        img(src='assets/img/coaches/Mattick.png', alt='', aria-hidden='true')
                                    .p-3
                                        h3#coach-mattick-heading.h5.mb-0 Mattick
                            .col-md-8.col-lg-9.d-flex.align-items-stretch
                                +coachBioPanel
                                    +coachBioLead
                                        | Mattick is a veteran professional wrestler, trainer, and mentor whose career has been built on perseverance, continuous growth, and a passion for professional wrestling. Trained by respected veteran Colin Delaney, Mattick has spent more than a decade honing his craft while establishing himself as one of the most recognizable competitors on the Western New York independent wrestling scene. Since making his debut in 2013, he has developed a reputation for his hard-hitting style, athleticism, and dedication to the fundamentals of professional wrestling.
                                    +coachBioSection('In the Ring')
                                        | Throughout his career, Mattick has competed against and alongside a wide range of established independent wrestling stars and nationally recognized talent, gaining invaluable experience in front of diverse audiences and in various wrestling environments. These opportunities have helped shape his understanding of ring psychology, character development, and the professionalism required to succeed in the industry.
                                    +coachBioSection('Accolades')
                                        | As a competitor, Mattick earned recognition in Pro Wrestling Illustrated’s PWI 500 rankings, a testament to his hard work and commitment to excellence inside the ring. His accomplishments as both a singles wrestler and tag team competitor have made him a respected figure throughout the Northeast wrestling scene.
                                    +coachBioSection('As a Trainer')
                                        | Mattick focuses on helping students build strong fundamentals, ring awareness, conditioning, and confidence. Drawing from over a decade of experience, he emphasizes the importance of work ethic, adaptability, and attention to detail while creating a positive environment where wrestlers of all skill levels can learn and grow.
                                    +coachBioClose
                                        | Whether working with aspiring wrestlers taking their first steps into the business or experienced performers looking to refine their craft, Mattick is dedicated to passing on the knowledge, discipline, and passion that have defined his own wrestling journey.

                    .row.justify-content-center.mb-5
                        .col-lg-10
                            .gz-school-text-panel.p-0.overflow-hidden
                                img.w-100(src='assets/img/coaches/School1.JPG', alt='Ground Zero School training')

                    article#coach-nick.mb-5(aria-labelledby='coach-nick-heading')
                        .row.align-items-stretch.gy-3
                            .col-md-4.col-lg-3
                                .gz-coach-card.gz-roster-card.text-dark
                                    .gz-roster-media
                                        img(src='assets/img/coaches/nickando.png', alt='', aria-hidden='true')
                                    .p-3
                                        h3#coach-nick-heading.h5.mb-0 Nick Ando
                            .col-md-8.col-lg-9.d-flex.align-items-stretch
                                +coachBioPanel
                                    +coachBioLead
                                        | Nick Ando is a highly respected professional wrestler, coach, and mentor whose career has been defined by technical excellence, athleticism, and a commitment to helping others succeed. With years of experience competing throughout the independent wrestling scene, Ando has developed a reputation as a versatile performer capable of excelling in both singles and tag team competition while consistently demonstrating the fundamentals that form the foundation of professional wrestling.
                                    +coachBioSection('Experience')
                                        | Throughout his career, Ando has competed against and alongside some of the biggest names in professional wrestling, including Matt Hardy, Vader, Johnny Gargano, Kevin Steen, and The Good Brothers to name a few. These experiences have given him a unique perspective on the level of preparation, professionalism, and adaptability required to compete at the highest levels of the industry.
                                    +coachBioSection('As a Trainer')
                                        | Nick emphasizes strong fundamentals, conditioning, ring psychology, movement, and professional development. He believes that success in wrestling comes from mastering the details, and he works closely with students to help them build confidence, sharpen their abilities, and develop their own unique identities as performers.
                                    +coachBioClose
                                        | Known for his patient and hands-on approach to coaching, Ando is committed to creating a positive learning environment where wrestlers of all experience levels can grow. Whether training beginners taking their first bumps or experienced competitors looking to elevate their game, Nick brings passion, knowledge, and a genuine investment in the success of every student he works with. His goal is not only to create better wrestlers, but to help develop complete performers who are prepared for every opportunity the industry presents.

                    article#coach-krist.mb-5(aria-labelledby='coach-krist-heading')
                        .row.align-items-stretch.gy-3
                            .col-md-4.col-lg-3
                                .gz-coach-card.gz-roster-card.text-dark
                                    .gz-roster-media
                                        img(src='assets/img/coaches/kristworthless.png', alt='', aria-hidden='true')
                                    .p-3
                                        h3#coach-krist-heading.h5.mb-0 Krist XW
                            .col-md-8.col-lg-9.d-flex.align-items-stretch
                                +coachBioPanel
                                    +coachBioLead
                                        | Krist Worthless brings a unique international perspective to professional wrestling training, combining years of in-ring experience with advanced education from some of the most respected wrestling systems in the world. Dedicated to the craft of professional wrestling, Worthless has expanded his knowledge far beyond the traditional independent wrestling path by studying and training internationally to develop a deeper understanding of both the athletic and psychological aspects of the profession.
                                    +coachBioSection('International Training')
                                        | His wrestling education includes training and study in Japan, where he gained firsthand experience with the discipline, conditioning, and strong-style fundamentals that have made Japanese professional wrestling renowned worldwide. In addition, Worthless furthered his development in Germany under the guidance of WALTER (now known as Gunther), learning the hard-hitting European style that emphasizes precision, physicality, ring psychology, and purposeful storytelling.
                                    +coachBioSection('As a Trainer')
                                        | Krist combines these international influences with practical independent wrestling experience to provide students with a well-rounded approach to the sport. His instruction focuses on fundamentals, striking, movement, ring awareness, psychology, conditioning, and developing a professional mindset that prepares wrestlers for success in any environment.
                                    +coachBioSection('Teaching Philosophy')
                                        | Known for his passion for learning and teaching, Worthless encourages students to embrace continuous growth while building a strong foundation that will serve them throughout their careers. Drawing from his experiences training across different wrestling cultures, he helps aspiring wrestlers understand not only how to perform moves, but why every action inside the ring matters.
                                    +coachBioClose
                                        | Whether working with beginners or experienced competitors, Krist Worthless is committed to helping students elevate their skills, expand their knowledge, and develop into complete professional wrestlers capable of succeeding anywhere in the world.

                    .row.justify-content-center.mb-5
                        .col-lg-10
                            .gz-school-text-panel.p-0.overflow-hidden
                                img.w-100(src='assets/img/coaches/School2.JPG', alt='Ground Zero School training')

                    article#coach-cloudy.mb-5(aria-labelledby='coach-cloudy-heading')
                        .row.align-items-stretch.gy-3
                            .col-md-4.col-lg-3
                                .gz-coach-card.gz-roster-card.text-dark
                                    .gz-roster-media
                                        img(src='assets/img/coaches/cloudy.png', alt='', aria-hidden='true')
                                    .p-3
                                        h3#coach-cloudy-heading.h5.mb-0 Cloudy
                            .col-md-8.col-lg-9.d-flex.align-items-stretch
                                +coachBioPanel
                                    +coachBioLead
                                        | A veteran of the independent wrestling scene with more than two decades of experience, Cloudy has earned a reputation as one of the most respected competitors and tag team specialists in the Northeast. Since making his professional debut in 2002, he has competed for numerous promotions throughout the United States and Canada, showcasing a hard-hitting style, strong fundamentals, and a deep understanding of in-ring storytelling.
                                    +coachBioSection('Career Highlights')
                                        | Throughout his career, Cloudy has captured multiple championships, including several NWA Upstate Tag Team Championships alongside longtime partner Cheech, the NWA Upstate No Limits Championship, the 2CW Tag Team Championship, and numerous regional titles. Cloudy has helped establish one of the most successful and influential teams on the independent wrestling circuit, earning recognition for exceptional chemistry, innovative offense, and consistent performances against top competition.
                                    +coachBioSection('As a Trainer')
                                        | Cloudy emphasizes the fundamentals that create lasting success in professional wrestling: ring awareness, psychology, conditioning, teamwork, and professionalism. His extensive experience in both singles and tag team competition allows him to provide students with a well-rounded perspective on every aspect of the industry.
                                    +coachBioClose
                                        | Drawing from years of experience competing against some of the best talent in professional wrestling, Cloudy is dedicated to helping the next generation of wrestlers develop their skills, build confidence, and prepare for success both inside and outside the ring.

                    article#coach-cheech.mb-5(aria-labelledby='coach-cheech-heading')
                        .row.align-items-stretch.gy-3
                            .col-md-4.col-lg-3
                                .gz-coach-card.gz-roster-card.text-dark
                                    .gz-roster-media
                                        img(src='assets/img/coaches/cheech.png', alt='', aria-hidden='true')
                                    .p-3
                                        h3#coach-cheech-heading.h5.mb-0 Cheech
                            .col-md-8.col-lg-9.d-flex.align-items-stretch
                                +coachBioPanel
                                    +coachBioLead
                                        | With more than two decades of experience in professional wrestling, Cheech Hernandez has established himself as one of the most respected and innovative competitors on the independent wrestling scene. Since debuting in 2004, Cheech has competed throughout the United States and Canada, earning a reputation for his high-energy style, technical ability, and creative approach to professional wrestling.
                                    +coachBioSection('Career Highlights')
                                        | A highly accomplished champion, Cheech’s career accolades include four AIW Tag Team Championships alongside Colin Delaney, the A1 Zero Gravity Championship, A1 Tag Team Championship, IWA Mid-South Championship, IWS Tag Team Championship, NWA Upstate No Limits Championship, multiple NWA Upstate Tag Team Championships with longtime partner Cloudy, the 2CW Tag Team Championship, and several heavyweight and regional titles throughout the Northeast independent wrestling scene.
                                    +coachBioSection('As a Trainer')
                                        | Cheech combines years of in-ring experience with a passion for developing the next generation of wrestlers. His instruction emphasizes fundamentals, athletic movement, tag team wrestling, ring psychology, character development, and adapting to the evolving demands of the industry. Whether working with beginners or experienced competitors, Cheech is committed to helping students build the skills, confidence, and professionalism necessary for long-term success in professional wrestling.
                                    +coachBioClose
                                        | Drawing from a career that has spanned premier independent promotions across North America, Cheech offers students a unique perspective on what it takes to succeed both inside the ring and beyond it.

                    #seminars-at-ground-zero.mt-5.pt-4(aria-labelledby='seminars-heading')
                        .gz-school-text-panel.mb-4
                            h2#seminars-heading.h3.mb-3 Seminars
                            p.text-muted.mb-0
                                | Wrestling seminars held at Ground Zero

                        if siteData.seminarGuests && siteData.seminarGuests.length
                            .row.row-cols-1.row-cols-md-2.row-cols-lg-3.g-4
                                each guest, guestIdx in siteData.seminarGuests
                                    -
                                        const seminarImg = guest.image || 'assets/img/roster/placeholder.svg'
                                        const seminarTag = guest.date || ''
                                        const seminarDetail = guest.note || ''
                                        const hasSeminarGallery = guest.hasGallery && guest.slides && guest.slides.length
                                    .col.h-100
                                        if hasSeminarGallery
                                            button.gz-seminar-card-trigger(
                                                type='button',
                                                data-seminar-index=guestIdx,
                                                aria-haspopup='dialog',
                                                aria-controls='gzSeminarModal',
                                                aria-label=`Open seminar photos: ${guest.name}`
                                            )
                                                span.gz-seminar-card-trigger-inner.d-block
                                                    +seminarGuestCard(seminarImg, guest, seminarTag, seminarDetail)
                                        else
                                            .gz-seminar-card-static.h-100
                                                +seminarGuestCard(seminarImg, guest, seminarTag, seminarDetail)

                            #gzSeminarModal.modal.fade(
                                tabindex='-1',
                                aria-labelledby='gzSeminarModalLabel',
                                aria-hidden='true'
                            )
                                .modal-dialog.modal-lg.modal-dialog-centered.modal-dialog-scrollable
                                    .modal-content
                                        .modal-header
                                            h2#gzSeminarModalLabel.modal-title.h5
                                            button.btn-close(
                                                type='button',
                                                data-bs-dismiss='modal',
                                                aria-label='Close'
                                            )
                                        .modal-body.p-0
                                            #gzSeminarCarousel.carousel.slide(data-bs-ride='false')
                                                .carousel-inner
                                                button.carousel-control-prev(
                                                    type='button',
                                                    data-bs-target='#gzSeminarCarousel',
                                                    data-bs-slide='prev',
                                                    aria-label='Previous image'
                                                )
                                                    span.carousel-control-prev-icon(aria-hidden='true')
                                                button.carousel-control-next(
                                                    type='button',
                                                    data-bs-target='#gzSeminarCarousel',
                                                    data-bs-slide='next',
                                                    aria-label='Next image'
                                                )
                                                    span.carousel-control-next-icon(aria-hidden='true')

                            script#gz-seminar-guests-data(type='application/json')!= JSON.stringify(siteData.seminarGuests || [])